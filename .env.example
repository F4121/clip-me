DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Local, free tooling (no keys needed for the MVP). Point these at your
# whisper.cpp build (see README) if they differ from the defaults below.
# WHISPER_MODEL_PATH must be a multilingual model (no ".en" suffix) —
# English-only models can't transcribe Indonesian or any other language.
WHISPER_CPP_BIN="./whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL_PATH="./models/ggml-base.bin"
# "auto" only looks at the first ~30s of audio to guess the language, then
# uses that guess for the whole file — a music/non-speech intro can lock in
# the wrong language for everything after it. If most of your videos are a
# known language, set this instead of "auto" to skip detection entirely,
# e.g.:
# WHISPER_LANGUAGE="id"

# Reserved for a future paid-AI phase. Unused by the MVP code.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
