DATABASE_URL="file:./dev.db"

NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Local, free tooling (no keys needed for the MVP). Point these at your
# whisper.cpp build (see README) if they differ from the defaults below.
# WHISPER_MODEL_PATH must be a multilingual model (no ".en" suffix) —
# English-only models can't transcribe Indonesian or any other language.
WHISPER_CPP_BIN="./whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL_PATH="./models/ggml-base.bin"

# Reserved for a future paid-AI phase. Unused by the MVP code.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
